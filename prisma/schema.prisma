// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Account {
  id       String  @id @default(uuid())
  phone    String  @unique
  email    String?
  password String? // optional if OTP only
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     Users[]

  @@index([phone])
  @@map("accounts")
}

model Users {
  id      String  @id @default(uuid())
  name    String
  roleId  Int     @map("role_id")
  email   String?
  address String

  accountId String? @map("account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  leftAt DateTime? @map("left_at")

  //relations
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  //relations
  role             Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  students         Student[]
  gurdians         Gurdians[]
  teachers         Teachers[]
  salaryStructures SalaryStructure[]
  salaryPayments   SalaryPayment[]

  @@index([accountId])
  @@map("users")
}

model Role {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users Users[]

  @@index([name])
  @@map("roles")
}

model AcademicYear {
  id        String    @id @default(uuid())
  fromYear  String    @map("from_year")
  toYear    String    @map("to_year")
  createdAt DateTime  @default(now()) @map("created_at")
  students  Student[]

  @@unique([fromYear, toYear])
  @@map("academic_years")
}

model Student {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  age         Int
  dob         String
  gender      String
  bloodGroup  String? @map("blood_group")
  admissionNo String  @map("admission_no")
  rollNo      Int     @map("roll_no")

  sectionId      String        @map("section_id")
  academicYearId String        @map("academic_year_id")
  admissionDate  DateTime
  photo          String?
  status         StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt

  // relations
  user         Users             @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  section      Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  gurdians     StudentGurdians[]
  attendances  Attendance[]

  @@unique([userId, admissionNo, rollNo], name: "student_unique")
  @@index([userId, admissionNo, rollNo])
  @@map("students")
}

model Class {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  //relations
  sections      Section[]
  classSubjects ClassSubject[]
  timetables    Timetable[]
  attendances   Attendance[]

  @@index([name])
  @@map("classes")
}

model Section {
  id           String       @id @default(uuid())
  name         String
  classId      String       @map("class_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  supervisorId String?      @unique @map("supervisor_id")
  //relations
  students     Student[]
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher      Teachers?    @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  timetables   Timetable[]
  attendances  Attendance[]

  // @@unique([id, teacherId], name: "section_unique")
  @@unique([classId, name], name: "section_unique_2")
  @@index([supervisorId])
  @@map("sections")
}

model Teachers {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  enrollmentNo  String   @map("enrollment_no")
  qualification String
  exoperience   String
  joiningDate   DateTime
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  altPhone1 String? @map("alt_phone_1")
  altPhone2 String? @map("alt_phone_2")

  //relations
  sections    Section[]
  timetables  Timetable[]
  attendances Attendance[]

  @@unique([userId, enrollmentNo], name: "teacher_unique")
  @@index([userId, enrollmentNo])
  @@map("teachers")
}

model Gurdians {
  id         String   @id @default(uuid())
  occupation String
  userId     String   @map("user_id")
  type       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  phone String?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  //relations
  studentGurdians StudentGurdians[]

  @@map("gurdians")
}

model StudentGurdians {
  id        String @id @default(uuid())
  studentId String @map("student_id")
  gurdianId String @map("gurdian_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isPrimary Boolean @default(false)

  //relations
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gurdian Gurdians @relation(fields: [gurdianId], references: [id], onDelete: Cascade)

  @@unique([studentId, gurdianId], name: "student_gurdian_unique")
  @@index([studentId, gurdianId])
  @@map("student_gurdians")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime

  @@map("otps")
}

model SalaryStructure {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  effectiveFrom   DateTime  @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  basicSalary     Float     @map("basic_salary")
  hra             Float?    @map("hra")
  allowance       Float?    @map("allowance")
  pf              Float?    @map("pf")
  esi             Float?    @map("esi")
  professionalTax Float?    @map("professional_tax")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom, effectiveTo])
  @@map("salary_structures")
}

model SalaryPayment {
  id                String @id @default(uuid())
  userId            String @map("user_id")
  salaryStructureId String @map("salary_structure_id")

  month Int
  year  Int

  basic     Float
  hra       Float?
  allowance Float?

  fixedDeductions    Float @default(0)
  variableDeductions Float @default(0)
  variableAllowances Float @default(0)
  bonus              Float @default(0)

  grossSalary Float
  netSalary   Float

  status SalaryPaymentEnum @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        Users              @relation(fields: [userId], references: [id])
  adjustments SalaryAdjustment[]

  @@unique([userId, month, year], name: "salary_payment_unique")
  @@map("salary_payments")
}

model SalaryAdjustment {
  id       String @id @default(uuid())
  salaryId String @map("salary_id")

  title  String
  type   AdjustementType
  amount Float

  createdAt DateTime @default(now())

  salary SalaryPayment @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@index([salaryId])
  @@map("salary_adjustments")
}

model Subjects {
  id   String @id @default(uuid())
  name String @unique

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  classSubjects ClassSubject[]
  timetables    Timetable[]

  @@index([name])
  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(uuid())
  classId   String @map("class_id")
  subjectId String @map("subject_id")

  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model TimeSlot {
  id         String      @id @default(uuid())
  label      String
  startTime  String      @map("start_time")
  endTime    String      @map("end_time")
  timetables Timetable[]

  @@map("time_slots")
}

model Timetable {
  id String @id @default(uuid())

  classId    String  @map("class_id")
  sectionId  String  @map("section_id")
  subjectId  String  @map("subject_id")
  teacherId  String  @map("teacher_id")
  dayOfWeek  WeekDay @map("day_of_week")
  timeSlotId String  @map("time_slot_id")

  class    Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section  Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject  Subjects @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher  Teachers @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  timeSlot TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@unique([teacherId, dayOfWeek, timeSlotId])
  @@unique([classId, sectionId, dayOfWeek, timeSlotId])
  @@map("timetables")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String
  sectionId String
  date      DateTime
  status    AttendanceStatus
  markedBy  String?
  remarks   String?

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  teacher Teachers? @relation(fields: [markedBy], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([classId, sectionId, date])
  @@index([date])
  @@map("attendances")
}

enum StudentStatus {
  ACTIVE
  GRADUATE
  LEFT
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum SalaryPaymentEnum {
  PENDING
  PAID
}

enum AdjustementType {
  ALLOWANCE
  DEDUCTION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}
